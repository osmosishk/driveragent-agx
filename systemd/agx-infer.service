# driveragent-agx inference node (FrameLink in -> TensorRT -> ZMQ results 5560 / status 5561).
# Install (needs sudo, owner approval): see install_units.sh. Do NOT enable at boot without approval.
[Unit]
Description=driveragent-agx inference node (agx-infer)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=tonyho
Group=tonyho
WorkingDirectory=/home/tonyho/driveragent-agx
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/tonyho/driveragent-agx
ExecStart=/home/tonyho/driveragent-agx/.venv/bin/python -m infer.main --config /home/tonyho/driveragent-agx/config/infer.yaml
Restart=on-failure
RestartSec=3
# The node only reads cameras over UDP and publishes results. It has no CAN access by design.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/tonyho/driveragent-agx/data /home/tonyho/driveragent-agx/logs /home/tonyho/driveragent-agx/engines

[Install]
WantedBy=multi-user.target
