# @INSTANCE@-infer: driveragent-agx inference node (FrameLink in -> TensorRT -> ZMQ results and status).
# systemd SYSTEM unit for the owner who prefers system units. ops/install.sh --print-system-units makes this
# file from ops/units/system/agx-infer.service.in and prints the sudo commands. install.sh does not install it.
# The node only reads cameras over UDP and publishes results. It has no CAN access by design.
[Unit]
Description=driveragent-agx inference node (@INSTANCE@-infer, @REPO_TEXT@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
# PWD: pycapnp reads PWD. Without it, capnp writes a warning in the log.
Environment="PWD=@REPO@"
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=@REPO@"
@NOUSERSITE_LINE@
ExecStart="@PYTHON@" -m infer.main --config "@REPO@/config/infer.yaml"
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
