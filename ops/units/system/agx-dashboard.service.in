# @INSTANCE@-dashboard: driveragent-agx dashboard (FastAPI, HTTP Basic auth, private networks only).
# systemd SYSTEM unit for the owner who prefers system units. ops/install.sh --print-system-units makes this
# file from ops/units/system/agx-dashboard.service.in and prints the sudo commands. install.sh does not install it.
[Unit]
Description=driveragent-agx dashboard (@INSTANCE@-dashboard, @REPO_TEXT@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
# PWD: pycapnp reads PWD. Without it, capnp writes a warning in the log.
Environment="PWD=@REPO@"
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=@REPO@"
@NOUSERSITE_LINE@
ExecStart="@PYTHON@" -m dashboard.main --config "@REPO@/config/dashboard.yaml"
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
