# Copy to .env (mode 600). Never commit .env.
# Dashboard login (HTTP Basic). The night agent made a random password in .env.
AGX_DASH_USER=agx
AGX_DASH_PASSWORD=
# MQTT publisher: written, DISABLED. Fill in and set AGX_MQTT_ENABLED=1 to enable.
AGX_MQTT_ENABLED=0
AGX_MQTT_HOST=
AGX_MQTT_PORT=
AGX_MQTT_USER=
AGX_MQTT_PASSWORD=
AGX_MQTT_TOPIC_PREFIX=
AGX_MQTT_TLS=
