# secrets and local state (never in git)
.env
.venv/
__pycache__/
*.pyc
data/
logs/
run/
engines/
# reference clones and raw audit output (large, read-only reference)
ref/
docs/audit/
# test artefacts that are large
tests/out/
# test logs larger than 1 MB (commit only the summary: docs/test_results/RAW_LOGS.md)
test_logs/
.pytest_cache/
# machine configuration (made by ops/install.sh from config/templates/; not in git)
/config/*.yaml
